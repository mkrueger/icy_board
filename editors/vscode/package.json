{
	"name": "ppl-vscode",
	"displayName": "PPL Language Support",
	"description": "Language support for the PCBoard Programming Language",
	"license": "MIT",
	"version": "0.2.1",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"icyboard",
		"pcboard",
		"ppl",
		"language-server",
		"tower-lsp"
	],
	"repository": {
		"url": "https://github.com/mkrueger/icy_board"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"enabledApiProposals": [],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "The extension starts the language server, and Run PPE starts a compiler and a board, so a workspace it does not trust may not say which programs those are.",
			"restrictedConfigurations": [
				"ppl.binPath",
				"ppl.boardConfig",
				"ppl.runArguments"
			]
		}
	},
	"main": "./dist/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "ppl",
				"extensions": [
					".pps",
					".ppd",
					".ppx"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "PPL",
			"properties": {
				"ppl.binPath": {
					"type": "string",
					"scope": "machine-overridable",
					"default": "",
					"markdownDescription": "The directory holding the IcyBoard programs - `ppl-lsp`, `pplc` and `icboard`. Leave empty for the server that ships with the extension and the rest from your PATH."
				},
				"ppl.trace.server": {
					"type": "string",
					"scope": "window",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"enumDescriptions": [
						"No traces",
						"Error only",
						"Full log"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				},
				"ppl.boardConfig": {
					"type": "string",
					"scope": "machine-overridable",
					"default": "",
					"markdownDescription": "The `icboard.toml` a PPE is run against, or the directory holding it. Leave empty to look in the workspace folder and in `ICB_PATH`."
				},
				"ppl.runArguments": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"scope": "resource",
					"default": [
						"--ppe",
						"${ppe}"
					],
					"markdownDescription": "What `icboard` is called with. `${ppe}` is the built executable, `${source}` the file it came from and `${workspaceFolder}` the folder it lives in.\n\nTo run as a logged-in user, and to pass a PPE its parameters:\n\n`[\"--runppe\", \"Sysop;;PWRD:secret;PPE:${ppe};first;second\"]`"
				}
			}
		},
		"grammars": [
			{
				"language": "ppl",
				"scopeName": "source.pps",
				"path": "./syntaxes/ppl.tmGrammar.json"
			}
		],
		"semanticTokenTypes": [
			{
				"id": "label",
				"superType": "variable",
				"description": "A PPL jump label"
			},
			{
				"id": "constant",
				"superType": "variable",
				"description": "A PPL constant"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "ppl",
				"scopes": {
					"label": [
						"entity.name.label.ppl"
					],
					"constant": [
						"constant.language.ppl"
					]
				}
			}
		],
		"commands": [
			{
				"command": "ppl.run",
				"category": "PPL",
				"title": "Run PPE",
				"icon": "$(play)",
				"enablement": "editorLangId == ppl"
			},
			{
				"command": "ppl.runFile",
				"category": "PPL",
				"title": "Run PPE (This File Only)",
				"enablement": "editorLangId == ppl"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "ppl.run",
					"when": "resourceExtname == .pps",
					"group": "navigation"
				}
			]
		},
		"keybindings": [
			{
				"command": "ppl.run",
				"key": "ctrl+f5",
				"mac": "cmd+f5",
				"when": "editorTextFocus && editorLangId == ppl"
			}
		]
	},
	"scripts": {
		"compile": "npm run check-types && node esbuild.js --production",
		"check-types": "tsc --noEmit -p tsconfig.json",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "vsce package --no-dependencies"
	},
	"dependencies": {
		"vscode-languageclient": "9.0.1"
	},
	"devDependencies": {
		"@types/node": "24.6.2",
		"@types/vscode": "1.85.0",
		"@vscode/vsce": "^3.2.1",
		"esbuild": "^0.24.2",
		"npm-run-all": "^4.1.5",
		"typescript": "5.4.5"
	},
	"packageManager": "pnpm@8.15.7"
}