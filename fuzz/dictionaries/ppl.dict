# Tokens the mutator would otherwise have to spell out a byte at a time.
# libFuzzer dictionary, see -dict=

# blocks
"BEGIN"
"END"
"IF "
"THEN"
"ELSE"
"ELSEIF"
"ENDIF"
"WHILE"
"ENDWHILE"
"FOR "
"NEXT"
"TO "
"STEP"
"SELECT CASE"
"CASE"
"DEFAULT"
"ENDSELECT"
"REPEAT"
"UNTIL"
"LOOP"
"ENDLOOP"
"FOREACH"
"ENDFOREACH"
"BREAK"
"CONTINUE"
"RETURN"

# routines
"DECLARE"
"PROCEDURE"
"ENDPROC"
"FUNCTION"
"ENDFUNC"
"VAR "
"GOSUB"
"GOTO"
"ON ERROR"

# types
"INTEGER"
"STRING"
"BIGSTR"
"BOOLEAN"
"DATE"
"TIME"
"MONEY"
"BYTE"
"WORD"
"SWORD"
"SBYTE"
"UNSIGNED"
"DWORD"
"DDATE"
"FLOAT"
"DOUBLE"
"BYTES"
"RECORD"
"ENDRECORD"
"ENUM"
"ENDENUM"
"DIM"
"REDIM"

# directives
";$LANGUAGE "
";$INCLUDE:"
";$USEFUNCS"
"$LANGUAGE"
"$INCLUDE"

# statements that take a variable
"PRINT"
"PRINTLN"
"LET "
"GETUSER"
"PUTUSER"
"INPUT"
"DISPTEXT"
"NEWLINE"
"STOP"

# internal names a source should not reach
"PCALL"
"STATIC"
"PLACEHOLDER"
"<get>"
"<set>"

# constants that are not assignable
"AUTO"
"NOCLEAR"
"GUIDE"
"YESNO"
"HIGHASCII"
"TRUE"
"FALSE"

# punctuation and operators
"("
")"
"["
"]"
"."
","
":"
"&&"
"||"
"=="
"!="
"<="
">="
"+="
"-="
"*="
"/="
"^"
"%"
