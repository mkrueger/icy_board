;$LANGVERSION 400

CONST INTEGER DIVIDER = 0
CONST INTEGER PANEL = 1

BOOLEAN synchronized

; Upload a small primitive once. Definitions are hex-encoded DECDMAC strings.
Terminal.Macros.StartRecord(DIVIDER)
COLOR @X03
PRINT "+--------------------------------------------------+"
Terminal.Macros.StopRecord()
IF (!ERR().OK) GOTO MacroError

; A terminal macro can invoke another macro. PANEL stores two DECINVM calls
; rather than copying the divider bytes twice.
Terminal.Macros.StartRecord(PANEL)
Terminal.Macros.Play(DIVIDER)
NextMacroRow()
COLOR @X0F
PRINT "| DEC macros run inside the terminal.              |"
NextMacroRow()
PRINT "| Playback sends only a short DECINVM sequence.    |"
NextMacroRow()
Terminal.Macros.Play(DIVIDER)
Terminal.Macros.StopRecord()
IF (!ERR().OK) GOTO MacroError

CLS
Terminal.BeginUpdate()
synchronized = ERR().OK
ANSIPOS 8, 4
Terminal.Macros.Play(PANEL)
ANSIPOS 8, 11
Terminal.Macros.Play(PANEL)
IF synchronized THEN
    Terminal.EndUpdate()
ENDIF

COLOR @X07
ANSIPOS 1, 19
PRINTLN "Two panels, one uploaded macro."
Terminal.Macros.DeleteAll()
EXIT

:MacroError
COLOR @X07
PRINTLN "Terminal macros are unavailable: ", ERR().Message
Terminal.Macros.DeleteAll()

PROCEDURE NextMacroRow()
    PRINT Chr(27) + "[B"
    BACKUP 52
ENDPROC
