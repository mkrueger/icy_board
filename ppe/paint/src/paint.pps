;$LANGVERSION 400

CONST INTEGER SCREEN_W = 640
CONST INTEGER SCREEN_H = 400
CONST INTEGER CANVAS_X = 20
CONST INTEGER CANVAS_Y = 76
CONST INTEGER CANVAS_W = 600
CONST INTEGER CANVAS_H = 304
CONST INTEGER SWATCH_X = 144
CONST INTEGER SWATCH_Y = 25
CONST INTEGER SWATCH_STEP = 34
CONST INTEGER SWATCH_SIZE = 26
CONST INTEGER COLOR_COUNT = 8

; The canvas is presented once per frame; input is answered as it arrives.
CONST INTEGER FRAME_MS = 33

CONST UNSIGNED C_CANVAS = Rgb(255, 255, 255)
CONST UNSIGNED C_INK = Rgb(1, 2, 3)
CONST UNSIGNED C_FRAME = Rgb(35, 26, 19)

UNSIGNED colors(7)
INTEGER selected, brushSize
INTEGER mouseKind, mx, my, btn
INTEGER lastX, lastY, dragButton
INTEGER tries
UNSIGNED nextFrame
BOOLEAN running, dragging, dirty, pendingInput
STRING key
SURFACE screen, ui
EVENT inputEvent
TERMINPUT input

InitColors()
CLS
PRINTLN "Starting PPE Paint..."

GfxInit GFX_AUTO
IF GfxBackend() < 0 THEN
    CLS
    PRINTLN "PPE Paint requires a graphics-capable terminal."
    EXIT
ENDIF
screen = NewSurface(SCREEN_W, SCREEN_H)
ui = LoadSurface("./paint_ui.png")
screen.Blit(ui, 0, 0)

selected = 0
brushSize = 7
dragging = FALSE
dirty = FALSE
RenderToolbar()

input = Terminal.Input
input.MouseOn(MOUSE_PIXELS, MOUSE_TRACK_ALL)
tries = 0
inputEvent = input.Poll()
WHILE !inputEvent.Pixels & tries < 30 DO
    DELAY 1
    inputEvent = input.Poll()
    tries += 1
ENDWHILE
IF !inputEvent.Pixels THEN
    input.Release()
    GfxShutdown
    CLS
    PRINTLN "PPE Paint requires pixel mouse reporting (DEC mode 1016)."
    EXIT
ENDIF
pendingInput = inputEvent.Kind <> EVENT_NONE
nextFrame = inputEvent.Time + FRAME_MS

running = TRUE
WHILE running DO
    dirty = FALSE
    IF pendingInput THEN
        pendingInput = FALSE
    ELSE
        inputEvent = input.Poll()
    ENDIF
    WHILE inputEvent.Kind <> EVENT_NONE DO
        IF inputEvent.Kind = EVENT_MOUSE THEN
            mouseKind = inputEvent.Code
            mx = inputEvent.X
            my = inputEvent.Y
            btn = inputEvent.Button

            IF mouseKind = MOUSE_PRESS THEN
                IF my < CANVAS_Y THEN
                    HandleToolbar(mx, my)
                ELSEIF (InsideCanvas(mx, my)) THEN
                    IF btn = 0 | btn = 2 THEN
                        dragging = TRUE
                        dragButton = btn
                        lastX = mx
                        lastY = my
                        DrawStroke(lastX, lastY, mx, my, StrokeColor(btn))
                    ENDIF
                ENDIF
            ELSEIF (mouseKind = MOUSE_MOTION) THEN
                IF dragging & btn = dragButton & InsideCanvas(mx, my) THEN
                    DrawStroke(lastX, lastY, mx, my, StrokeColor(btn))
                    lastX = mx
                    lastY = my
                ENDIF
            ELSEIF (mouseKind = MOUSE_RELEASE) THEN
                dragging = FALSE
            ELSEIF (mouseKind = MOUSE_WHEEL) THEN
                IF btn = 3 THEN
                    ChangeBrush(1)
                ELSEIF (btn = 4) THEN
                    ChangeBrush(-1)
                ENDIF
            ENDIF
        ELSEIF (inputEvent.Kind = EVENT_KEY) THEN
            key = Upper(inputEvent.Text)
            IF key = "Q" | key = Chr(27) THEN
                running = FALSE
            ELSEIF (key = "C") THEN
                ClearCanvas()
            ELSEIF (key = "+" | key = "=") THEN
                ChangeBrush(1)
            ELSEIF (key = "-") THEN
                ChangeBrush(-1)
            ENDIF
        ENDIF
        inputEvent = input.Poll()
    ENDWHILE
    IF dirty PresentDirty()
    IF inputEvent.Time < nextFrame THEN
        inputEvent = input.Wait(nextFrame - inputEvent.Time)
        pendingInput = inputEvent.Kind <> EVENT_NONE
    ENDIF
    IF inputEvent.Time >= nextFrame nextFrame = inputEvent.Time + FRAME_MS
ENDWHILE

input.Release()
ui.Free()
screen.Free()
GfxShutdown
CLS

PROCEDURE InitColors()
    colors[0] = Rgb(34, 34, 34)
    colors[1] = Rgb(240, 103, 103)
    colors[2] = Rgb(245, 154, 74)
    colors[3] = Rgb(245, 213, 71)
    colors[4] = Rgb(100, 214, 107)
    colors[5] = Rgb(66, 217, 232)
    colors[6] = Rgb(91, 143, 249)
    colors[7] = Rgb(167, 109, 255)
ENDPROC

FUNCTION InsideCanvas(INTEGER x, INTEGER y) BOOLEAN
    InsideCanvas = x >= CANVAS_X & x < CANVAS_X + CANVAS_W & y >= CANVAS_Y & y < CANVAS_Y + CANVAS_H
ENDFUNC

FUNCTION StrokeColor(INTEGER whichButton) UNSIGNED
    IF whichButton = 2 THEN
        StrokeColor = C_CANVAS
    ELSE
        StrokeColor = colors[selected]
    ENDIF
ENDFUNC

PROCEDURE RenderToolbar()
    INTEGER i, x
    ; Restore the original toolbar, then draw state indicators.
    screen.BlitRect(ui, 0, 0, SCREEN_W, CANVAS_Y, 0, 0)
    i = 0
    WHILE i < COLOR_COUNT DO
        x = SWATCH_X + i * SWATCH_STEP
        screen.FillRect(x, SWATCH_Y, SWATCH_SIZE, SWATCH_SIZE, colors[i])
        screen.Rect(x, SWATCH_Y, SWATCH_SIZE, SWATCH_SIZE, C_INK)
        IF i = selected screen.Rect(x - 3, SWATCH_Y - 3, SWATCH_SIZE + 6, SWATCH_SIZE + 6, C_CANVAS)
        i += 1
    ENDWHILE
    ; Brush preview.
    screen.FillRect(432, 25, 36, 28, C_CANVAS)
    screen.Rect(432, 25, 36, 28, C_FRAME)
    screen.FillRect(450 - brushSize / 2, 39 - brushSize / 2, brushSize, brushSize, colors[selected])
    screen.Present()
ENDPROC

PROCEDURE HandleToolbar(INTEGER x, INTEGER y)
    INTEGER index
    IF x >= SWATCH_X & x < SWATCH_X + COLOR_COUNT * SWATCH_STEP & y >= SWATCH_Y & y < SWATCH_Y + SWATCH_SIZE THEN
        index = (x - SWATCH_X) / SWATCH_STEP
        IF index >= 0 & index < COLOR_COUNT THEN
            selected = index
            RenderToolbar()
            RETURN
        ENDIF
    ENDIF
    IF x >= 480 & x < 510 & y >= 25 & y < 53 THEN
        ChangeBrush(-1)
    ELSEIF (x >= 518 & x < 548 & y >= 25 & y < 53) THEN
        ChangeBrush(1)
    ELSEIF (x >= 556 & x < 624 & y >= 25 & y < 53) THEN
        ClearCanvas()
    ENDIF
ENDPROC

PROCEDURE ChangeBrush(INTEGER amount)
    brushSize += amount * 2
    IF brushSize < 1 brushSize = 1
    IF brushSize > 31 brushSize = 31
    RenderToolbar()
ENDPROC

PROCEDURE ClearCanvas()
    screen.FillRect(CANVAS_X, CANVAS_Y, CANVAS_W, CANVAS_H, C_CANVAS)
    screen.Rect(CANVAS_X, CANVAS_Y, CANVAS_W, CANVAS_H, C_FRAME)
    screen.Present()
ENDPROC

PROCEDURE Dab(INTEGER x, INTEGER y, UNSIGNED color)
    INTEGER half, drawLeft, drawTop
    half = brushSize / 2
    drawLeft = x - half
    drawTop = y - half
    IF drawLeft < CANVAS_X drawLeft = CANVAS_X
    IF drawTop < CANVAS_Y drawTop = CANVAS_Y
    screen.FillRect(drawLeft, drawTop, brushSize, brushSize, color)
ENDPROC

PROCEDURE DrawStroke(INTEGER x0, INTEGER y0, INTEGER x1, INTEGER y1, UNSIGNED color)
    INTEGER dx, dy, sx, sy, err, e2
    dx = Abs(x1 - x0)
    dy = 0 - Abs(y1 - y0)
    sx = -1
    IF x0 < x1 sx = 1
    sy = -1
    IF y0 < y1 sy = 1
    err = dx + dy

    LOOP
        Dab(x0, y0, color)
        IF x0 = x1 & y0 = y1 BREAK
        e2 = err * 2
        IF e2 >= dy THEN
            err += dy
            x0 += sx
        ENDIF
        IF e2 <= dx THEN
            err += dx
            y0 += sy
        ENDIF
    ENDLOOP

    dirty = TRUE
ENDPROC

PROCEDURE PresentDirty()
    ; Sixel terminals do not consistently preserve previous images under
    ; transparent partial updates. The event batch still limits this to one
    ; complete image per frame.
    screen.Present()
ENDPROC
