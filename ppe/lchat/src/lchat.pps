;$LANGVERSION 400

DECLARE FUNCTION LoadConfiguration() BOOLEAN
DECLARE FUNCTION PagingIsOpen() BOOLEAN
DECLARE FUNCTION RequestEmergencyPage() BOOLEAN
DECLARE FUNCTION ReadPageReason() BOOLEAN
DECLARE FUNCTION WaitForSysop() INTEGER
DECLARE FUNCTION PollPageAction() INTEGER
DECLARE FUNCTION MinutesOfDay(STRING value) INTEGER
DECLARE FUNCTION CharacterColor(INTEGER code, INTEGER chatter) STRING
DECLARE FUNCTION LastSpace(BIGSTR text) INTEGER
DECLARE FUNCTION VisibleLength(BIGSTR text) INTEGER

DECLARE PROCEDURE RunChat()
DECLARE PROCEDURE HandleInput(STRING key, INTEGER chatter, INTEGER top, INTEGER bottom, VAR INTEGER cursorX, VAR INTEGER cursorY)
DECLARE PROCEDURE AppendCharacter(STRING key, INTEGER chatter, INTEGER row)
DECLARE PROCEDURE PrintColored(STRING key, INTEGER chatter)
DECLARE PROCEDURE Backspace(INTEGER chatter, INTEGER top, VAR INTEGER cursorX, VAR INTEGER cursorY)
DECLARE PROCEDURE WrapLine(INTEGER chatter, INTEGER top, INTEGER bottom, VAR INTEGER cursorX, VAR INTEGER cursorY)
DECLARE PROCEDURE ScrollPane(INTEGER chatter, INTEGER top, INTEGER bottom, VAR INTEGER cursorY)
DECLARE PROCEDURE ClearPane(INTEGER chatter, INTEGER top, INTEGER bottom)
DECLARE PROCEDURE RedrawPane(INTEGER chatter, INTEGER top, INTEGER bottom)
DECLARE PROCEDURE RedrawChat()
DECLARE PROCEDURE Finish(STRING message, BOOLEAN pause)

CONST INTEGER SYSOP = 1
CONST INTEGER CALLER = 2
CONST INTEGER SYSOP_TOP = 2
CONST INTEGER SYSOP_BOTTOM = 11
CONST INTEGER CALLER_TOP = 13
CONST INTEGER CALLER_BOTTOM = 22
CONST INTEGER FIRST_CHAT_COLUMN = 4
CONST INTEGER LAST_CHAT_COLUMN = 77

STRING SysopName
STRING PageHours
STRING SysopLowerColor
STRING SysopUpperColor
STRING SysopNumberColor
STRING SysopPunctuationColor
STRING SysopOtherColor
STRING CallerLowerColor
STRING CallerUpperColor
STRING CallerNumberColor
STRING CallerPunctuationColor
STRING CallerOtherColor

BIGSTR ChatLines(10, 2)
BOOLEAN PageBell = TRUE
BOOLEAN PageActive = FALSE

BEGIN
    SAVESCRN

    IF !LoadConfiguration() THEN
        Finish("lchat.cfg not found", FALSE)
    ENDIF

    STRING argument = Upper(GetToken())
    IF argument = "/A" THEN
        RunChat()
    ENDIF

    IF !PagingIsOpen() THEN
        IF !RequestEmergencyPage() THEN
            Finish("", FALSE)
        ENDIF
    ENDIF

    IF !ReadPageReason() THEN
        Finish("The chat reason is not long enough!", TRUE)
    ENDIF

    INTEGER pageResult
    pageResult = WaitForSysop()
    IF pageResult < 0 THEN
        Finish("User aborted chat.", TRUE)
    ELSE
        IF pageResult = 0 THEN
            Finish("The sysop is not available for chat now.", TRUE)
        ENDIF
    ENDIF

    RunChat()
END

FUNCTION LoadConfiguration() BOOLEAN
    IF Exist(PPEPath() + "lchat.cfg") = 0 THEN
        RETURN FALSE
    ENDIF

    SysopLowerColor = ReadLine(PPEPath() + "lchat.cfg", 1)
    SysopUpperColor = ReadLine(PPEPath() + "lchat.cfg", 2)
    SysopNumberColor = ReadLine(PPEPath() + "lchat.cfg", 3)
    SysopPunctuationColor = ReadLine(PPEPath() + "lchat.cfg", 4)
    SysopOtherColor = ReadLine(PPEPath() + "lchat.cfg", 5)
    CallerLowerColor = ReadLine(PPEPath() + "lchat.cfg", 6)
    CallerUpperColor = ReadLine(PPEPath() + "lchat.cfg", 7)
    CallerNumberColor = ReadLine(PPEPath() + "lchat.cfg", 8)
    CallerPunctuationColor = ReadLine(PPEPath() + "lchat.cfg", 9)
    CallerOtherColor = ReadLine(PPEPath() + "lchat.cfg", 10)
    PageHours = ReadLine(PPEPath() + "lchat.cfg", 10 + Dow(Date()))
    SysopName = ReadLine(PCBDat(), 2)
    RETURN TRUE
ENDFUNC

FUNCTION PagingIsOpen() BOOLEAN
    STRING opens = Left(PageHours, 8)
    STRING closes = Right(PageHours, 8)
    IF opens = closes THEN
        RETURN TRUE
    ENDIF
    INTEGER now = MinutesOfDay(Time())
    RETURN now > MinutesOfDay(opens) && now < MinutesOfDay(closes)
ENDFUNC

FUNCTION MinutesOfDay(STRING value) INTEGER
    RETURN Left(value, 2) * 60 + Mid(value, 4, 2)
ENDFUNC

FUNCTION RequestEmergencyPage() BOOLEAN
    PRINTLN "@X0BT@X03he @X0BS@X03ysop can@X02'@X03t be paged now @X02..."
    PRINTLN "@X0BT@X03ry it between @X02: @X09", PageHours
    PRINTLN "@X0BB@X03ut if u know the magic code @X02... @X03u can page emergency"

    STRING answer = "N"
    INPUTYN "@X0BDo you want to page emergency (Y/N)? @X00", answer, 7
    IF Upper(answer) = "N" THEN
        RETURN FALSE
    ENDIF

    PRINTLN
    PRINTLN "@X0BEnter the magic code : @X07"
    STRING code
    INPUT "_", code
    IF Upper(code) = Upper(ReadLine(PPEPath() + "lchat.cfg", 18)) THEN
        RETURN TRUE
    ENDIF

    PRINTLN
    PRINTLN "@X0BInvalid emergency code."
    DELAY 10
    RETURN FALSE
ENDFUNC

FUNCTION ReadPageReason() BOOLEAN
    DISPFILE PPEPath() + "data\pagescr.pcb", GRAPH
    ANSIPOS 13, 10
    PAGEON
    PageActive = TRUE

    INTEGER reasonLength
    LOOP
        STRING key = InKey()
        IF key = Chr(8) && reasonLength > 0 THEN
            PRINT Chr(8), " ", Chr(8)
            reasonLength = reasonLength - 1
            CONTINUE
        ENDIF
        IF key = Chr(13) THEN
            RETURN reasonLength >= 3
        ENDIF
        INTEGER code = Asc(key)
        IF code >= 32 && reasonLength < 57 THEN
            PrintColored(key, CALLER)
            reasonLength = reasonLength + 1
        ENDIF
    ENDLOOP
ENDFUNC

FUNCTION WaitForSysop() INTEGER
    ANSIPOS 1, 12
    PRINTLN "                         @X0BP@X03aging @X0BS@X03ysop @X02... @X03please wait"
    PRINTLN "                   @X02@X01╔════════════════════════════════════════╗"
    PRINTLN "                    @X0F░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░"
    PRINTLN "                   @X01╚════════════════════════════════════════╝"
    MPRINTLN "                                  <A>bort page"
    SPRINTLN "               <C>hat with user <A> Abort page <S> Turn bell off"
    ANSIPOS 21, 14

    INTEGER pageLoop
    FOR pageLoop = 0 TO 40
        IF PageBell THEN
            SPRINT Chr(7)
        ENDIF
        INTEGER pulse
        FOR pulse = 1 TO 6
            INTEGER action
            action = PollPageAction()
            IF action != 0 THEN
                RETURN action
            ENDIF
            DELAY 1
        NEXT pulse
        PRINT "@X08■"
    NEXT pageLoop
    RETURN 0
ENDFUNC

FUNCTION PollPageAction() INTEGER
    STRING callerKey = Upper(MInkey())
    STRING sysopKey = Upper(KInkey())
    IF callerKey = "A" || sysopKey = "A" THEN
        RETURN -1
    ENDIF
    IF sysopKey = "C" THEN
        RETURN 1
    ENDIF
    IF sysopKey = "S" THEN
        PageBell = FALSE
    ENDIF
    RETURN 0
ENDFUNC

PROCEDURE RunChat()
    IF PageActive THEN
        PAGEOFF
        PageActive = FALSE
    ENDIF

    INTEGER sysopX = FIRST_CHAT_COLUMN
    INTEGER sysopY = SYSOP_TOP
    INTEGER callerX = FIRST_CHAT_COLUMN
    INTEGER callerY = CALLER_TOP
    RedrawChat()
    ANSIPOS sysopX, sysopY

    LOOP
        STRING sysopKey = KInkey()
        IF sysopKey = Chr(27) THEN
            Finish("Chat ended.", TRUE)
        ENDIF
        HandleInput(sysopKey, SYSOP, SYSOP_TOP, SYSOP_BOTTOM, sysopX, sysopY)

        STRING callerKey = MInkey()
        IF callerKey = Chr(27) THEN
            Finish("User aborted chat.", TRUE)
        ENDIF
        HandleInput(callerKey, CALLER, CALLER_TOP, CALLER_BOTTOM, callerX, callerY)
    ENDLOOP
ENDPROC

PROCEDURE HandleInput(STRING key, INTEGER chatter, INTEGER top, INTEGER bottom, VAR INTEGER cursorX, VAR INTEGER cursorY)
    IF key = "" THEN
        RETURN
    ENDIF

    INTEGER code = Asc(key)
    IF code = 18 THEN
        RedrawChat()
        ANSIPOS cursorX, cursorY
        RETURN
    ENDIF
    IF code = 23 THEN
        ClearPane(chatter, top, bottom)
        cursorX = FIRST_CHAT_COLUMN
        cursorY = top
        ANSIPOS cursorX, cursorY
        RETURN
    ENDIF
    IF code = 13 THEN
        cursorX = FIRST_CHAT_COLUMN
        cursorY = cursorY + 1
        IF cursorY > bottom THEN
            ScrollPane(chatter, top, bottom, cursorY)
        ENDIF
        ChatLines[cursorY - top + 1, chatter] = ""
        ANSIPOS cursorX, cursorY
        RETURN
    ENDIF
    IF code = 8 THEN
        Backspace(chatter, top, cursorX, cursorY)
        RETURN
    ENDIF
    IF code < 32 THEN
        RETURN
    ENDIF

    ANSIPOS cursorX, cursorY
    AppendCharacter(key, chatter, cursorY - top + 1)
    cursorX = cursorX + 1
    WrapLine(chatter, top, bottom, cursorX, cursorY)
ENDPROC

PROCEDURE AppendCharacter(STRING key, INTEGER chatter, INTEGER row)
    STRING color = CharacterColor(Asc(key), chatter)
    PRINT color, key
    ChatLines[row, chatter] += color + key
ENDPROC

PROCEDURE PrintColored(STRING key, INTEGER chatter)
    PRINT CharacterColor(Asc(key), chatter), key
ENDPROC

FUNCTION CharacterColor(INTEGER code, INTEGER chatter) STRING
    IF code >= 48 && code <= 57 THEN
        IF chatter = SYSOP RETURN SysopNumberColor
        RETURN CallerNumberColor
    ENDIF
    IF code >= 65 && code <= 90 THEN
        IF chatter = SYSOP RETURN SysopUpperColor
        RETURN CallerUpperColor
    ENDIF
    IF code >= 97 && code <= 122 THEN
        IF chatter = SYSOP RETURN SysopLowerColor
        RETURN CallerLowerColor
    ENDIF
    IF code <= 128 THEN
        IF chatter = SYSOP RETURN SysopPunctuationColor
        RETURN CallerPunctuationColor
    ENDIF
    IF chatter = SYSOP RETURN SysopOtherColor
    RETURN CallerOtherColor
ENDFUNC

PROCEDURE Backspace(INTEGER chatter, INTEGER top, VAR INTEGER cursorX, VAR INTEGER cursorY)
    IF cursorX <= FIRST_CHAT_COLUMN && cursorY > top THEN
        cursorY = cursorY - 1
        cursorX = FIRST_CHAT_COLUMN + VisibleLength(ChatLines[cursorY - top + 1, chatter])
    ENDIF
    IF cursorX <= FIRST_CHAT_COLUMN THEN
        RETURN
    ENDIF

    INTEGER row = cursorY - top + 1
    INTEGER length = Len(ChatLines[row, chatter])
    IF length >= 5 THEN
        ChatLines[row, chatter] = Left(ChatLines[row, chatter], length - 5)
    ENDIF
    cursorX = cursorX - 1
    ANSIPOS cursorX, cursorY
    PRINT " "
    ANSIPOS cursorX, cursorY
ENDPROC

PROCEDURE WrapLine(INTEGER chatter, INTEGER top, INTEGER bottom, VAR INTEGER cursorX, VAR INTEGER cursorY)
    IF cursorX <= LAST_CHAT_COLUMN THEN
        RETURN
    ENDIF

    INTEGER row = cursorY - top + 1
    INTEGER split
    split = LastSpace(ChatLines[row, chatter])
    BIGSTR carry
    IF split > 0 THEN
        carry = Right(ChatLines[row, chatter], Len(ChatLines[row, chatter]) - split)
        ChatLines[row, chatter] = Left(ChatLines[row, chatter], split)
    ENDIF

    cursorY = cursorY + 1
    IF cursorY > bottom THEN
        ScrollPane(chatter, top, bottom, cursorY)
    ENDIF
    row = cursorY - top + 1
    ChatLines[row, chatter] = carry
    RedrawPane(chatter, top, bottom)
    cursorX = FIRST_CHAT_COLUMN + VisibleLength(carry)
    ANSIPOS cursorX, cursorY
ENDPROC

FUNCTION LastSpace(BIGSTR text) INTEGER
    INTEGER position = Len(text)
    WHILE position > 0 DO
        IF Mid(text, position, 1) = " " THEN
            RETURN position
        ENDIF
        position = position - 5
    ENDWHILE
    RETURN 0
ENDFUNC

FUNCTION VisibleLength(BIGSTR text) INTEGER
    RETURN Len(text) / 5
ENDFUNC

PROCEDURE ScrollPane(INTEGER chatter, INTEGER top, INTEGER bottom, VAR INTEGER cursorY)
    INTEGER line
    FOR line = 1 TO 9
        ChatLines[line, chatter] = ChatLines[line + 1, chatter]
    NEXT line
    ChatLines[10, chatter] = ""
    cursorY = bottom
    RedrawPane(chatter, top, bottom)
ENDPROC

PROCEDURE ClearPane(INTEGER chatter, INTEGER top, INTEGER bottom)
    INTEGER line
    FOR line = 1 TO 10
        ChatLines[line, chatter] = ""
    NEXT line
    RedrawPane(chatter, top, bottom)
ENDPROC

PROCEDURE RedrawChat()
    DISPFILE PPEPath() + "data\lchat.pcb", GRAPH
    RedrawPane(SYSOP, SYSOP_TOP, SYSOP_BOTTOM)
    RedrawPane(CALLER, CALLER_TOP, CALLER_BOTTOM)
    ANSIPOS (80 - Len(SysopName) + 2) / 2, 1
    PRINT "@X0F[@X0B", SysopName, "@X0F]"
    ANSIPOS (80 - Len(U_Name()) + 2) / 2, 12
    PRINT "[@X0B", U_Name(), "@X0F]"
ENDPROC

PROCEDURE RedrawPane(INTEGER chatter, INTEGER top, INTEGER bottom)
    INTEGER screenRow
    FOR screenRow = top TO bottom
        ANSIPOS FIRST_CHAT_COLUMN, screenRow
        PRINT "                                                                          "
        ANSIPOS FIRST_CHAT_COLUMN, screenRow
        PRINT ChatLines[screenRow - top + 1, chatter]
    NEXT
ENDPROC

PROCEDURE Finish(STRING message, BOOLEAN pause)
    IF PageActive THEN
        PAGEOFF
        PageActive = FALSE
    ENDIF
    CLS
    IF message != "" THEN
        PRINTLN "@X0B", message
    ENDIF
    IF pause THEN
        MORE
    ENDIF
    RESTSCRN
    EXIT
ENDPROC