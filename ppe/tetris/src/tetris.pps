    shapes[5] = shapes[4]
    shapes[6] = shapes[4]
    shapes[7] = shapes[4]
    shapes[8] = "0100111000000000"
    shapes[9] = "0100011001000000"
    shapes[10] = "0000111001000000"
    shapes[11] = "0100110001000000"
