PROCEDURE DrawText(STRING text, INTEGER x, INTEGER y)
    INTEGER i, index, px, py
    STRING letter
    text = Upper(text)
    FOR i = 1 TO Len(text)
        letter = Mid(text, i, 1)
        IF letter <> " " THEN
            index = InStr(ALPHABET, letter) - 1
            IF index < 0 index = 36
            FOR py = 0 TO 6
                FOR px = 0 TO 4
                    IF Mid(glyphs[index], py * 5 + px + 1, 1) = "1" THEN
                        game.SetPixel(x + px, y + py, GB_DARKEST)
                    ENDIF
                NEXT px
            NEXT py
        ENDIF
        x += 6
    NEXT i
ENDPROC

