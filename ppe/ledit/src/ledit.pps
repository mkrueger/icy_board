;$LANGVERSION 400

CONST INTEGER MAX_LINES = 200
CONST INTEGER EDIT_WIDTH = 76
CONST INTEGER FIRST_EDIT_ROW = 5
CONST INTEGER LAST_EDIT_ROW = 22
CONST INTEGER VISIBLE_LINES = LAST_EDIT_ROW - FIRST_EDIT_ROW + 1

STRING lines[199]
INTEGER lineCount = 1
INTEGER cursorLine = 0
INTEGER cursorColumn = 0
INTEGER firstVisible = 0
BOOLEAN editing = TRUE
BOOLEAN saveMessage = FALSE
TERMINPUT input = Terminal.Input

BEGIN
    STRING recipient, subject, privacy

    DrawAddressScreen()
    recipient = ReadField(35, 12, 24).Trim()

    IF recipient.Equals("SYSOP", StringComparison.OrdinalIgnoreCase) THEN
        recipient = Board.SysopName
    ENDIF
    IF recipient = "" THEN
        recipient = "ALL"
        ANSIPOS 35, 12
        COLOR @X0B
        PRINT recipient
    ENDIF

    IF !recipient.Equals("ALL", StringComparison.OrdinalIgnoreCase) & U_RecNum(recipient) = -1 THEN
        input.Release()
        CLS
        PRINTLN "@X0BU@X03ser not found@X02."
        DELAY 2
        EXIT
    ENDIF

    subject = ReadField(35, 13, 24).Trim()
    IF subject = "" THEN
        input.Release()
        CLS
        PRINTLN "@X0BM@X03essage aborted@X02."
        DELAY 2
        EXIT
    ENDIF

    privacy = "N"
    IF !recipient.Equals("ALL", StringComparison.OrdinalIgnoreCase) THEN
        privacy = ReadYesNo(51, 14)
    ENDIF

    DrawEditor(recipient, subject)
    WHILE editing DO
        EVENT keyEvent = input.Wait(-1)
        IF keyEvent.Kind = EventKind.Key THEN
            HandleKey(keyEvent)
        ENDIF
    ENDWHILE

    input.Release()
    IF !saveMessage THEN
        CLS
        PRINTLN "@X0BM@X03essage aborted@X02."
        DELAY 2
        EXIT
    ENDIF

    STRING tempFile = PPEPath() + "ledit.tmp"
    IF WriteMessageFile(tempFile) THEN
        STRING status = "N"
        IF privacy = "Y" status = "R"
        MESSAGE CurConf(), recipient, Session.UserName, subject, status, Date(), FALSE, FALSE, tempFile
        DELETE tempFile
    ELSE
        CLS
        PRINTLN "@X0BC@X03ould not create the temporary message file@X02."
        DELAY 2
    ENDIF
END

;;; Reads a single-line field using the modern terminal event API.
FUNCTION ReadField(INTEGER x, INTEGER y, INTEGER width) STRING
    STRING value = ""
    BOOLEAN reading = TRUE

    ANSIPOS x, y
    COLOR @X07
    PRINT STRING.Repeat("·", width)
    ANSIPOS x, y

    WHILE reading DO
        EVENT keyEvent = input.Wait(-1)
        IF keyEvent.Kind <> EventKind.Key CONTINUE

        IF (keyEvent.Code = KEY_ENTER) THEN
            reading = FALSE
        ELSEIF (keyEvent.Code = KEY_BACKSPACE) THEN
            IF (value.Len() > 0) THEN
                value = value.Left(value.Len() - 1)
                ANSIPOS x + value.Len(), y
                COLOR @X07
                PRINT "·"
                ANSIPOS x + value.Len(), y
            ENDIF
        ELSEIF (keyEvent.Code = KEY_ESCAPE) THEN
            value = ""
            reading = FALSE
        ELSEIF (keyEvent.Text.Len() = 1 & Asc(keyEvent.Text) >= 32 & value.Len() < width) THEN
            STRING character = keyEvent.Text
            IF value = "" | value.EndsWith(" ") character = character.ToUpper()
            value += character
            PrintInputCharacter(character)
        ENDIF
    ENDWHILE

    RETURN value
ENDFUNC

FUNCTION ReadYesNo(INTEGER x, INTEGER y) STRING
    ANSIPOS x, y
    COLOR @X09
    PRINT "N"

    LOOP
        EVENT keyEvent = input.Wait(-1)
        IF keyEvent.Kind <> EventKind.Key CONTINUE
        STRING answer = keyEvent.Text.ToUpper()
        IF (answer = "Y" | answer = "N") THEN
            ANSIPOS x, y
            PRINT answer
            RETURN answer
        ENDIF
        IF keyEvent.Code = KEY_ENTER | keyEvent.Code = KEY_ESCAPE RETURN "N"
    ENDLOOP
ENDFUNC

PROCEDURE PrintInputCharacter(STRING character)
    INTEGER code = Asc(character)
    IF (code >= 48 & code <= 57) THEN
        COLOR @X09
    ELSEIF (code >= 65 & code <= 90) THEN
        COLOR @X0B
    ELSEIF (code >= 97 & code <= 122) THEN
        COLOR @X03
    ELSEIF (code > 127) THEN
        COLOR @X0E
    ELSE
        COLOR @X02
    ENDIF
    PRINT character
ENDPROC

PROCEDURE HandleKey(EVENT keyEvent)
    STRING key = keyEvent.Text
    STRING upperKey = key.ToUpper()

    IF (keyEvent.Code = 19 | (keyEvent.Ctrl & upperKey = "S")) THEN
        saveMessage = TRUE
        editing = FALSE
        RETURN
    ENDIF
    IF (keyEvent.Code = 1 | (keyEvent.Ctrl & upperKey = "A") | keyEvent.Code = KEY_ESCAPE) THEN
        saveMessage = FALSE
        editing = FALSE
        RETURN
    ENDIF

    IF (keyEvent.Code = KEY_UP) THEN
        MoveVertical(-1)
    ELSEIF (keyEvent.Code = KEY_DOWN) THEN
        MoveVertical(1)
    ELSEIF (keyEvent.Code = KEY_LEFT) THEN
        MoveLeft()
    ELSEIF (keyEvent.Code = KEY_RIGHT) THEN
        MoveRight()
    ELSEIF (keyEvent.Code = KEY_HOME) THEN
        cursorColumn = 0
    ELSEIF (keyEvent.Code = KEY_END) THEN
        cursorColumn = lines[cursorLine].Len()
    ELSEIF (keyEvent.Code = KEY_PAGE_UP) THEN
        MoveVertical(0 - VISIBLE_LINES)
    ELSEIF (keyEvent.Code = KEY_PAGE_DOWN) THEN
        MoveVertical(VISIBLE_LINES)
    ELSEIF (keyEvent.Code = KEY_ENTER) THEN
        SplitLine()
    ELSEIF (keyEvent.Code = KEY_BACKSPACE) THEN
        Backspace()
    ELSEIF (keyEvent.Code = KEY_DELETE) THEN
        DeleteCharacter()
    ELSEIF (!keyEvent.Ctrl & key.Len() = 1 & Asc(key) >= 32) THEN
        InsertCharacter(key)
    ENDIF

    KeepCursorVisible()
    PositionCursor()
ENDPROC

PROCEDURE MoveVertical(INTEGER amount)
    cursorLine += amount
    IF cursorLine < 0 cursorLine = 0
    IF cursorLine >= lineCount cursorLine = lineCount - 1
    IF cursorColumn > lines[cursorLine].Len() cursorColumn = lines[cursorLine].Len()
ENDPROC

PROCEDURE MoveLeft()
    IF (cursorColumn > 0) THEN
        cursorColumn -= 1
    ELSEIF (cursorLine > 0) THEN
        cursorLine -= 1
        cursorColumn = lines[cursorLine].Len()
    ENDIF
ENDPROC

PROCEDURE MoveRight()
    IF (cursorColumn < lines[cursorLine].Len()) THEN
        cursorColumn += 1
    ELSEIF (cursorLine + 1 < lineCount) THEN
        cursorLine += 1
        cursorColumn = 0
    ENDIF
ENDPROC

PROCEDURE InsertCharacter(STRING character)
    IF lines[cursorLine].Len() >= EDIT_WIDTH RETURN
    lines[cursorLine] = Left(lines[cursorLine], cursorColumn) + character + Mid(lines[cursorLine], cursorColumn + 1, EDIT_WIDTH)
    cursorColumn += 1
    DrawTextRow(cursorLine)
ENDPROC

PROCEDURE SplitLine()
    IF lineCount >= MAX_LINES RETURN

    INTEGER index = lineCount
    WHILE index > cursorLine + 1 DO
        lines[index] = lines[index - 1]
        index -= 1
    ENDWHILE
    lines[cursorLine + 1] = Mid(lines[cursorLine], cursorColumn + 1, lines[cursorLine].Len() - cursorColumn)
    lines[cursorLine] = lines[cursorLine].Left(cursorColumn)
    lineCount += 1
    cursorLine += 1
    cursorColumn = 0
    KeepCursorVisible()
    DrawVisibleLines()
ENDPROC

PROCEDURE Backspace()
    IF cursorColumn > 0 THEN
        lines[cursorLine] = Left(lines[cursorLine], cursorColumn - 1) + Mid(lines[cursorLine], cursorColumn + 1, EDIT_WIDTH)
        cursorColumn -= 1
        DrawTextRow(cursorLine)
        RETURN
    ENDIF
    IF cursorLine = 0 RETURN
    IF lines[cursorLine - 1].Len() + lines[cursorLine].Len() > EDIT_WIDTH RETURN

    cursorColumn = lines[cursorLine - 1].Len()
    lines[cursorLine - 1] += lines[cursorLine]
    RemoveLine(cursorLine)
    cursorLine -= 1
    KeepCursorVisible()
    DrawVisibleLines()
ENDPROC

PROCEDURE DeleteCharacter()
    IF cursorColumn < lines[cursorLine].Len() THEN
        lines[cursorLine] = Left(lines[cursorLine], cursorColumn) + Mid(lines[cursorLine], cursorColumn + 2, EDIT_WIDTH)
        DrawTextRow(cursorLine)
        RETURN
    ENDIF
    IF cursorLine + 1 >= lineCount RETURN
    IF lines[cursorLine].Len() + lines[cursorLine + 1].Len() > EDIT_WIDTH RETURN

    lines[cursorLine] += lines[cursorLine + 1]
    RemoveLine(cursorLine + 1)
    DrawVisibleLines()
ENDPROC

PROCEDURE RemoveLine(INTEGER line)
    INTEGER index = line
    WHILE index + 1 < lineCount DO
        lines[index] = lines[index + 1]
        index += 1
    ENDWHILE
    lineCount -= 1
    lines[lineCount] = ""
ENDPROC

PROCEDURE KeepCursorVisible()
    INTEGER oldFirst = firstVisible
    IF cursorLine < firstVisible firstVisible = cursorLine
    IF cursorLine >= firstVisible + VISIBLE_LINES firstVisible = cursorLine - VISIBLE_LINES + 1
    IF oldFirst <> firstVisible DrawVisibleLines()
ENDPROC

PROCEDURE PositionCursor()
    ANSIPOS cursorColumn + 2, FIRST_EDIT_ROW + cursorLine - firstVisible
ENDPROC

PROCEDURE DrawVisibleLines()
    INTEGER row
    FOR row = 0 TO VISIBLE_LINES - 1
        DrawTextRow(firstVisible + row)
    NEXT
ENDPROC

PROCEDURE DrawTextRow(INTEGER line)
    INTEGER screenRow = FIRST_EDIT_ROW + line - firstVisible
    IF screenRow < FIRST_EDIT_ROW | screenRow > LAST_EDIT_ROW RETURN

    STRING text = ""
    IF line < lineCount text = lines[line]
    IF text.Len() < EDIT_WIDTH text += Space(EDIT_WIDTH - text.Len())
    ANSIPOS 2, screenRow
    COLOR @X0E
    PRINT text.Left(EDIT_WIDTH)
ENDPROC

FUNCTION WriteMessageFile(STRING fileName) BOOLEAN
    FCREATE 1, fileName, O_WR, S_DN
    IF !Error.Last().OK RETURN FALSE

    INTEGER lastLine = lineCount - 1
    WHILE lastLine > 0 & lines[lastLine] = "" DO
        lastLine -= 1
    ENDWHILE

    INTEGER index
    FOR index = 0 TO lastLine
        FPUTLN 1, lines[index]
        IF !Error.Last().OK THEN
            FCLOSE 1
            RETURN FALSE
        ENDIF
    NEXT
    FCLOSE 1
    RETURN Error.Last().OK
ENDFUNC

PROCEDURE DrawAddressScreen()
    CLS
    COLOR @X0D
    PRINTLN "                         Write a LiQUiD message"
    PRINTLN
    PRINTLN "               +----------------------------------------------+"
    PRINTLN "               |                                              |"
    PRINTLN "               |                                              |"
    PRINTLN "               |                                              |"
    PRINTLN "               +----------------------------------------------+"
    PRINTLN
    PRINTLN
    PRINTLN
    PRINTLN "               | To (Enter=ALL) : ........................ |"
    PRINTLN "               | Subject        : ........................ |"
    PRINTLN "               | Private (Y/N)  : ( )                      |"
    COLOR @X07
ENDPROC

PROCEDURE DrawEditor(STRING recipient, STRING subject)
    CLS
    COLOR @X0B
    STRING border = "+" + STRING.Repeat("-", EDIT_WIDTH) + "+"
    PRINTLN border
    PRINTLN "| To   : ", Left(recipient + Space(56), 56), "LiQUiD Edit |"
    PRINTLN "| Subj : ", Left(subject + Space(51), 51), "^A Abort ^S Save |"
    PRINTLN border
    INTEGER row
    FOR row = FIRST_EDIT_ROW TO LAST_EDIT_ROW
        ANSIPOS 1, row
        PRINT "|"
        ANSIPOS 78, row
        PRINT "|"
    NEXT
    ANSIPOS 1, LAST_EDIT_ROW + 1
    PRINT border
    DrawVisibleLines()
    PositionCursor()
ENDPROC
