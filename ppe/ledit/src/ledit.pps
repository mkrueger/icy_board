;$LANGVERSION 400

CONST INTEGER MAX_LINES = 200
CONST INTEGER EDIT_WIDTH = 76
CONST INTEGER FIRST_EDIT_ROW = 5
CONST INTEGER LAST_EDIT_ROW = 22
CONST INTEGER VISIBLE_LINES = LAST_EDIT_ROW - FIRST_EDIT_ROW + 1

STRING lines[199]
INTEGER lineCount = 1
INTEGER cursorLine = 0
INTEGER cursorColumn = 0
INTEGER firstVisible = 0
BOOLEAN editing = TRUE
BOOLEAN saveMessage = FALSE
STRING workDir, language
STRING messageInfo[5]
INTEGER inputBytes = 0
INTEGER expectedBytes = 0
TERMINPUT input = Terminal.Input

BEGIN
    GETTOKEN workDir
    GETTOKEN language
    IF workDir = "" THEN
        input.Release()
        STOP
    ENDIF
    ON ERROR GOTO FileError

    IF !LoadDraft() THEN
        input.Release()
        PRINTLN Label("Draft exceeds 200 lines or 76 columns. Not saved.", "Entwurf hat mehr als 200 Zeilen oder 76 Spalten. Nicht gespeichert.")
        STOP
    ENDIF
    FCREATE 2, workDir + "/KEYBUF", O_WR, S_DN
    FCLOSE 2
    FOPEN 2, workDir + "/KEYBUF", O_RW, S_DN

    STARTDISP FNS
    DrawEditor(messageInfo[1], messageInfo[2])
    WHILE editing DO
        EVENT keyEvent = input.Wait(-1)
        IF keyEvent.Kind = EventKind.Key THEN
            HandleKey(keyEvent)
        ENDIF
    ENDWHILE

    input.Release()
    FCLOSE 2
    IF !saveMessage THEN
        STOP
    ENDIF

    IF !WriteMessageFile(workDir + "/MSGTMP") GOTO FileError
    FCREATE 1, workDir + "/RESULT.ED", O_WR, S_DN
    FPUTLN 1, "0"
    FPUTLN 1, messageInfo[2]
    FPUTLN 1, "LiQUiD Edit 1.1.0"
    FCLOSE 1
    EXIT

:FileError
    ERROR failure = Error.Last()
    ON ERROR OFF
    input.Release()
    PRINT Label("Editor error. Not saved: ", "Editorfehler. Nicht gespeichert: ")
    PrintText(failure.Message)
    PRINTLN
    STOP
END

FUNCTION Label(STRING english, STRING german) STRING
    IF language.ToLower() = "de" RETURN german
    RETURN english
ENDFUNC

FUNCTION DisplayText(STRING text) STRING
    STRING visible = ""
    INTEGER index
    FOR index = 0 TO text.Len() - 1
        STRING character = text.Substring(index, 1)
        IF Asc(character) < 32 | Asc(character) = 127 THEN
            visible += "."
        ELSE
            visible += character
        ENDIF
    NEXT
    RETURN visible
ENDFUNC

PROCEDURE PrintText(STRING text)
    STRING parts[] = DisplayText(text).Split("@")
    INTEGER index
    FOR index = 0 TO parts.Len() - 1
        IF index > 0 PRINT "@"
        PRINT parts[index]
    NEXT
ENDPROC

FUNCTION LoadDraft() BOOLEAN
    FOPEN 1, workDir + "/MSGINF", O_RD, S_DN
    INTEGER index
    FOR index = 0 TO 5
        FGET 1, messageInfo[index]
        IF FERR(1) THEN
            FCLOSE 1
            GOTO FileError
        ENDIF
    NEXT
    FCLOSE 1
    FOPEN 1, workDir + "/MSGTMP", O_RD, S_DN
    lineCount = 0
    STRING text
    LOOP
        FGET 1, text
        IF FERR(1) BREAK
        IF lineCount >= MAX_LINES | text.Len() > EDIT_WIDTH THEN
            FCLOSE 1
            RETURN FALSE
        ENDIF
        lines[lineCount] = text
        lineCount += 1
    ENDLOOP
    FCLOSE 1
    IF lineCount = 0 lineCount = 1
    RETURN TRUE
ENDFUNC

FUNCTION InputCharacter(EVENT keyEvent) STRING
    INTEGER code = keyEvent.Code
    IF code > 255 RETURN keyEvent.Text
    IF !Terminal.Info.Utf8 RETURN CHR(code)
    IF code < 128 THEN
        inputBytes = 0
        RETURN keyEvent.Text
    ENDIF
    IF inputBytes > 0 & (code < 128 | code > 191) inputBytes = 0
    IF inputBytes = 0 THEN
        IF code < 194 | code > 244 RETURN ""
        expectedBytes = 2
        IF code >= 224 expectedBytes = 3
        IF code >= 240 expectedBytes = 4
        FSEEK 2, 0, 0
    ENDIF
    BYTE inputByte = code
    FWRITE 2, inputByte, 1
    inputBytes += 1
    IF inputBytes < expectedBytes RETURN ""
    FSEEK 2, 0, 0
    BYTES encoded
    FREAD 2, encoded, inputBytes
    inputBytes = 0
    RETURN encoded.ToString()
ENDFUNC

PROCEDURE HandleKey(EVENT keyEvent)
    STRING key = keyEvent.Text
    STRING upperKey = key.ToUpper()
    IF keyEvent.Code < 32 | keyEvent.Code > 255 inputBytes = 0

    IF (keyEvent.Code = 19 | (keyEvent.Ctrl & upperKey = "S")) THEN
        saveMessage = TRUE
        editing = FALSE
        RETURN
    ENDIF
    IF (keyEvent.Code = 1 | (keyEvent.Ctrl & upperKey = "A") | keyEvent.Code = KEY_ESCAPE) THEN
        saveMessage = FALSE
        editing = FALSE
        RETURN
    ENDIF

    IF (keyEvent.Code = KEY_UP) THEN
        MoveVertical(-1)
    ELSEIF (keyEvent.Code = KEY_DOWN) THEN
        MoveVertical(1)
    ELSEIF (keyEvent.Code = KEY_LEFT) THEN
        MoveLeft()
    ELSEIF (keyEvent.Code = KEY_RIGHT) THEN
        MoveRight()
    ELSEIF (keyEvent.Code = KEY_HOME) THEN
        cursorColumn = 0
    ELSEIF (keyEvent.Code = KEY_END) THEN
        cursorColumn = lines[cursorLine].Len()
    ELSEIF (keyEvent.Code = KEY_PAGE_UP) THEN
        MoveVertical(0 - VISIBLE_LINES)
    ELSEIF (keyEvent.Code = KEY_PAGE_DOWN) THEN
        MoveVertical(VISIBLE_LINES)
    ELSEIF (keyEvent.Code = KEY_ENTER) THEN
        SplitLine()
    ELSEIF (keyEvent.Code = KEY_BACKSPACE) THEN
        Backspace()
    ELSEIF (keyEvent.Code = KEY_DELETE) THEN
        DeleteCharacter()
    ELSEIF (!keyEvent.Ctrl & key.Len() = 1 & keyEvent.Code >= 32) THEN
        STRING character = InputCharacter(keyEvent)
        IF character <> "" InsertCharacter(character)
    ENDIF

    KeepCursorVisible()
    PositionCursor()
ENDPROC

PROCEDURE MoveVertical(INTEGER amount)
    cursorLine += amount
    IF cursorLine < 0 cursorLine = 0
    IF cursorLine >= lineCount cursorLine = lineCount - 1
    IF cursorColumn > lines[cursorLine].Len() cursorColumn = lines[cursorLine].Len()
ENDPROC

PROCEDURE MoveLeft()
    IF (cursorColumn > 0) THEN
        cursorColumn -= 1
    ELSEIF (cursorLine > 0) THEN
        cursorLine -= 1
        cursorColumn = lines[cursorLine].Len()
    ENDIF
ENDPROC

PROCEDURE MoveRight()
    IF (cursorColumn < lines[cursorLine].Len()) THEN
        cursorColumn += 1
    ELSEIF (cursorLine + 1 < lineCount) THEN
        cursorLine += 1
        cursorColumn = 0
    ENDIF
ENDPROC

PROCEDURE InsertCharacter(STRING character)
    IF lines[cursorLine].Len() >= EDIT_WIDTH RETURN
    lines[cursorLine] = Left(lines[cursorLine], cursorColumn) + character + Mid(lines[cursorLine], cursorColumn + 1, lines[cursorLine].Len() - cursorColumn)
    cursorColumn += 1
    DrawTextRow(cursorLine)
ENDPROC

PROCEDURE SplitLine()
    IF lineCount >= MAX_LINES RETURN

    INTEGER index = lineCount
    WHILE index > cursorLine + 1 DO
        lines[index] = lines[index - 1]
        index -= 1
    ENDWHILE
    lines[cursorLine + 1] = Mid(lines[cursorLine], cursorColumn + 1, lines[cursorLine].Len() - cursorColumn)
    lines[cursorLine] = lines[cursorLine].Left(cursorColumn)
    lineCount += 1
    cursorLine += 1
    cursorColumn = 0
    KeepCursorVisible()
    DrawVisibleLines()
ENDPROC

PROCEDURE Backspace()
    IF cursorColumn > 0 THEN
        lines[cursorLine] = Left(lines[cursorLine], cursorColumn - 1) + Mid(lines[cursorLine], cursorColumn + 1, lines[cursorLine].Len() - cursorColumn)
        cursorColumn -= 1
        DrawTextRow(cursorLine)
        RETURN
    ENDIF
    IF cursorLine = 0 RETURN
    IF lines[cursorLine - 1].Len() + lines[cursorLine].Len() > EDIT_WIDTH RETURN

    cursorColumn = lines[cursorLine - 1].Len()
    lines[cursorLine - 1] += lines[cursorLine]
    RemoveLine(cursorLine)
    cursorLine -= 1
    KeepCursorVisible()
    DrawVisibleLines()
ENDPROC

PROCEDURE DeleteCharacter()
    IF cursorColumn < lines[cursorLine].Len() THEN
        lines[cursorLine] = Left(lines[cursorLine], cursorColumn) + Mid(lines[cursorLine], cursorColumn + 2, lines[cursorLine].Len() - cursorColumn - 1)
        DrawTextRow(cursorLine)
        RETURN
    ENDIF
    IF cursorLine + 1 >= lineCount RETURN
    IF lines[cursorLine].Len() + lines[cursorLine + 1].Len() > EDIT_WIDTH RETURN

    lines[cursorLine] += lines[cursorLine + 1]
    RemoveLine(cursorLine + 1)
    DrawVisibleLines()
ENDPROC

PROCEDURE RemoveLine(INTEGER line)
    INTEGER index = line
    WHILE index + 1 < lineCount DO
        lines[index] = lines[index + 1]
        index += 1
    ENDWHILE
    lineCount -= 1
    lines[lineCount] = ""
ENDPROC

PROCEDURE KeepCursorVisible()
    INTEGER oldFirst = firstVisible
    IF cursorLine < firstVisible firstVisible = cursorLine
    IF cursorLine >= firstVisible + VISIBLE_LINES firstVisible = cursorLine - VISIBLE_LINES + 1
    IF oldFirst <> firstVisible DrawVisibleLines()
ENDPROC

PROCEDURE PositionCursor()
    ANSIPOS cursorColumn + 2, FIRST_EDIT_ROW + cursorLine - firstVisible
ENDPROC

PROCEDURE DrawVisibleLines()
    INTEGER row
    FOR row = 0 TO VISIBLE_LINES - 1
        DrawTextRow(firstVisible + row)
    NEXT
ENDPROC

PROCEDURE DrawTextRow(INTEGER line)
    INTEGER screenRow = FIRST_EDIT_ROW + line - firstVisible
    IF screenRow < FIRST_EDIT_ROW | screenRow > LAST_EDIT_ROW RETURN

    STRING text = ""
    IF line < lineCount text = lines[line]
    IF text.Len() < EDIT_WIDTH text += Space(EDIT_WIDTH - text.Len())
    ANSIPOS 2, screenRow
    COLOR @X0E
    PrintText(text.Left(EDIT_WIDTH))
ENDPROC

FUNCTION WriteMessageFile(STRING fileName) BOOLEAN
    FCREATE 1, fileName, O_WR, S_DN
    IF !Error.Last().OK RETURN FALSE

    INTEGER lastLine = lineCount - 1
    INTEGER index
    FOR index = 0 TO lastLine
        FPUTLN 1, lines[index]
        IF !Error.Last().OK THEN
            FCLOSE 1
            RETURN FALSE
        ENDIF
    NEXT
    FCLOSE 1
    RETURN Error.Last().OK
ENDFUNC

PROCEDURE DrawEditor(STRING recipient, STRING subject)
    CLS
    COLOR @X0B
    STRING border = "+" + STRING.Repeat("-", EDIT_WIDTH) + "+"
    PRINTLN border
    PRINT Label("| To   : ", "| An   : ")
    PrintText(Left(recipient + Space(56), 56))
    PRINTLN "LiQUiD Edit |"
    PRINT Label("| Subj : ", "| Betr.: ")
    PrintText(Left(subject + Space(43), 43))
    PRINTLN Label("^A Abort  ^S Save        |", "^A Abbruch ^S Speichern  |")
    PRINTLN border
    INTEGER row
    FOR row = FIRST_EDIT_ROW TO LAST_EDIT_ROW
        ANSIPOS 1, row
        PRINT "|"
        ANSIPOS 78, row
        PRINT "|"
    NEXT
    ANSIPOS 1, LAST_EDIT_ROW + 1
    PRINT border
    DrawVisibleLines()
    PositionCursor()
ENDPROC
