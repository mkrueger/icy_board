STRING s
BIGSTR b

PRINTLN "---BEGIN---"

b = SPACE(299) + "B"
FCREATE 1, "C:\COMPAT\STR255.TXT", O_WR, S_DN
FPUTLN 1, b
FCLOSE 1
FOPEN 1, "C:\COMPAT\STR255.TXT", O_RD, S_DN
FGET 1, s
FCLOSE 1
PRINTLN "fget300=", LEN(s), ":[", RIGHT(s, 3), "]"

FCREATE 1, "C:\COMPAT\STR255.BIN", O_WR, S_DN
FWRITE 1, b, 300
FCLOSE 1
FOPEN 1, "C:\COMPAT\STR255.BIN", O_RD, S_DN
FREAD 1, s, 300
FCLOSE 1
PRINTLN "fread300=", LEN(s), ":[", RIGHT(s, 3), "]"

FOPEN 1, "C:\COMPAT\STR255.BIN", O_RD, S_DN
FREAD 1, b, 300
FCLOSE 1
PRINTLN "fread_big300=", LEN(b), ":[", RIGHT(b, 3), "]"

PRINTLN "---END---"