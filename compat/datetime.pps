PROCEDURE DateValue(INTEGER value)
    PRINTLN "d", value, "=", TOINTEGER(TODATE(value)), "|", YEAR(value), "|", MONTH(value), "|", DAY(value), "|", DOW(value), "|[", TODDATE(value), "]|", TOEDATE(value)
ENDPROC

PROCEDURE MakeDate(INTEGER year, INTEGER month, INTEGER day)
    DATE value
    value = MKDATE(year, month, day)
    PRINTLN "m", year, ",", month, ",", day, "=", TOINTEGER(value), "|", YEAR(value), "|", MONTH(value), "|", DAY(value), "|", DOW(value)
ENDPROC

PROCEDURE DateText(STRING value)
    PRINTLN "s[", value, "]=", VALDATE(value), "|", TOINTEGER(TODATE(value)), "|", TOINTEGER(TODDATE(value)), "|", TOINTEGER(TOEDATE(value))
ENDPROC

PROCEDURE TimeText(STRING value)
    PRINTLN "t[", value, "]=", VALTIME(value), "|", TOINTEGER(TOTIME(value)), "|[", TOTIME(value), "]"
ENDPROC

PROCEDURE TimeValue(INTEGER value)
    PRINTLN "v", value, "=", HOUR(value), "|", MIN(value), "|", SEC(value), "|[", TIMEAP(value), "]|[", TOTIME(value), "]"
ENDPROC

PROCEDURE DDateText(STRING value)
    PRINTLN "q[", value, "]=", TOINTEGER(TODDATE(value)), "|[", TODDATE(value), "]"
ENDPROC

PROCEDURE OracleVersion()
    PRINTLN "oracle=", VER()
ENDPROC

PROCEDURE EDateText(STRING value)
    PRINTLN "e[", value, "]=", TOINTEGER(TOEDATE(value)), "|[", TOEDATE(value), "]"
ENDPROC

PROCEDURE DateDomain()
    INTEGER value, partsHash, textHash, roundtripHash
    STRING text
    partsHash = 0
    textHash = 0
    roundtripHash = 0
    FOR value = 0 TO 65535
        partsHash = partsHash * 33 + YEAR(value)
        partsHash = partsHash * 33 + MONTH(value)
        partsHash = partsHash * 33 + DAY(value)
        partsHash = partsHash * 33 + DOW(value)
        text = TODDATE(value)
        textHash = textHash * 33 + TOINTEGER(text)
        text = TODATE(value)
        roundtripHash = roundtripHash * 33 + TOINTEGER(TODATE(text))
    NEXT
    PRINTLN "domain=65536|", partsHash, "|", textHash, "|", roundtripHash
ENDPROC