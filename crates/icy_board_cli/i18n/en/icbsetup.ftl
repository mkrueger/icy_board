about = IcyBoard setup utility
full-screen = Use the full screen (default is 80x25)
version = Print the version and exit
file = Path/file name of the icyboard.toml configuration file
import-about = Import a PCBOARD.DAT file into IcyBoard
create-about = Create a new IcyBoard configuration
ppe-convert-about = Convert a directory to UTF-8
check-about = Report configuration paths that cannot be resolved
dos-image-about = Download and prepare the native FreeDOS door image and BIOS files
dos-copy-about = Copy a host file into a prepared DOS disk image
import-name = PCBOARD.DAT file or directory of the PCBoard installation to import
output-directory = Output directory
map = Map a DOS path to a local one; may be repeated: --map 'D:\FILES=/mnt/files'
dry-run = Only report what would be imported and which paths cannot be resolved
ppe-convert-path = Directory to convert
create-dirs = Offer to create missing directories
dos-image-directory = Board directory that will receive assets/dos
dos-copy-image = Prepared raw FreeDOS image
dos-copy-source = Host file to copy
dos-copy-destination = Destination path inside DOS, for example DOORS/LORD/LORD.EXE
genhelp-about = Generate, check or export BBS help
genhelp-check-about = Validate help sources; preflight installation when a board is found (no writes)
genhelp-export-about = Export embedded English Markdown sources and catalog, without theme files
genhelp-destination = New or empty destination directory for editable sources
genhelp-board = Board directory or configuration file; otherwise use the current directory or ICB_PATH if available
genhelp-output = Write generated files into this directory instead of a board; no ledger, backups or repair
genhelp-theme = Theme: classic, minimal, or the path to a theme TOML file
genhelp-width = Output width in terminal cells (40..79, default 79)
genhelp-cp437 = Write legacy CP437 instead of the default UTF-8 with a BOM; --cp437=false keeps UTF-8
genhelp-sources = Override source directory, relative to the current directory; a flat directory of topic Markdown files plus an optional catalog.toml
genhelp-language = File name extension for translated output such as ger; must match the board's configured language extension
genhelp-dry-run = Preflight generation without writing files or acquiring a board lock
genhelp-adopt = Adopt unmanaged outputs, backing up replaced files
genhelp-replace-modified = Replace modified managed outputs with backups; separate from adoption
genhelp-warning = Warning
genhelp-invalid-theme = Unknown help theme; expected classic, minimal or a readable theme file
genhelp-invalid-language = Invalid help language extension; expected 1 to 32 lowercase letters or digits, starting with a letter
genhelp-render-failed = Help rendering failed
genhelp-title-only = Legacy source contains only a title
genhelp-exported = Exported embedded sources and catalog; custom theme files belong outside this source directory
genhelp-board-not-found = IcyBoard configuration not found; pass a board directory or configuration file
genhelp-board-and-output = A board and --output cannot be combined; --output writes unmanaged files without a board
genhelp-output-conflicts = Existing files in the output directory; nothing was written, use --adopt to overwrite them
genhelp-replace-modified-without-board = Replacing modified outputs requires a board; --output keeps no ledger
genhelp-empty-output = Help output directory must not be empty
genhelp-checked = Validated help outputs
genhelp-would-write = Would write help outputs
genhelp-written = Wrote help outputs