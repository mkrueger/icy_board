about = Convert and maintain icy_board file bases
version = print the version and exit
areas-about = list the areas defined in a file_areas.toml
list-about = list the files in an area with their descriptions
scan-about = derive descriptions from the archives in an area
check-about = report entries whose file is missing or whose size no longer matches
import-about = read descriptions from PCBoard DIR listings or FILES.BBS files
export-about = write the descriptions of an area back out as a FILES.BBS
set-about = change the description or the flags of a single file
repack-about = rewrite the archives of an area as zip files, without the intros they carry
fingerprints-about = record the files in a directory so that repack can recognise them again
areas = path to the area list
target = a file directory, or a file_areas.toml together with --area
scan-target = a file directory, or a file_areas.toml together with --area or --all
area = area name or index when the target is a file_areas.toml
long = show size, date and download count as well
all = scan every area in a file_areas.toml
force = re-derive descriptions that were imported or edited by hand
prune = drop entries whose file is gone
listings = the listings to read
format = listing format: auto, pcboard or filesbbs
dry-run = report what would change without writing anything
overwrite = replace descriptions that are already there
keep-missing = also import entries whose file is not in the directory
output = write to this file instead of stdout, encoded as cp437
file = the file to change
desc = the new description
free = download costs no time: true or false
locked = file cannot be downloaded: true or false
fingerprints = fingerprints of the intros to drop, as written by the fingerprints command
keep-case = leave the case of the file names as it is
compression-level = zip deflate compression level from 0 through 9
max-members = maximum number of members accepted in one archive
max-member-size = maximum expanded size of one member in bytes
max-expanded-size = maximum expanded size of the complete archive in bytes
max-compression-ratio = maximum permitted expanded-to-compressed ratio
input = the directory holding the intros
fingerprints-output = where to write the fingerprints
unknown-format = unknown format
expected-format = expected auto, pcboard or filesbbs