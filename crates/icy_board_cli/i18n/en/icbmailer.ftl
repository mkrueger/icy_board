about = Exchange FTN, QWKnet and ZCONNECT mail with configured systems
version = print the version and exit
links-about = list the configured links and what is waiting for them
poll-about = call a link, hand over what is waiting for it and take what it has
scan-about = pack the mail written here into bundles for the links that carry its area
show-about = list what is inside a packet or a mail bundle
toss-about = read the mail waiting in the inbound into the message bases
qwk-links-about = list configured QWKnet hubs
qwk-poll-about = scan, exchange and import mail for a QWKnet hub
qwk-scan-about = create REP packets from locally written messages
qwk-toss-about = import QWK packets waiting in the inbound directory
zconnect-links-about = list configured ZCONNECT links and public board mappings
zconnect-scan-about = prepare retryable ZCONNECT ZIP packets from local public text
zconnect-toss-about = import per-link inbound ZIP packets and preserve unsupported mail
zconnect-poll-about = scan, exchange over cleartext Telnet and import all received ZIP packets
zconnect-ack-about = manually acknowledge one link's pending packet ONLY after verified external delivery
zconnect-link = link ID, every configured link when left out
zconnect-ack-link = required link ID; confirms verified delivery by an external offline mailer and retires its pending packet
zconnect-not-configured = No paths.zconnect_file is configured in the board configuration
zconnect-disabled = ZCONNECT processing is disabled
zconnect-no-links = No matching ZCONNECT links are configured
zconnect-busy = Another ZCONNECT operation is active for this link
zconnect-offline = offline only
zconnect-areas = areas
zconnect-messages = messages
zconnect-no-messages = no new messages
zconnect-unsafe-packet = Unsafe ZCONNECT packet or archive directory
zconnect-imported = imported
zconnect-duplicates = duplicates
zconnect-loops = loops
zconnect-unsupported = unsupported
zconnect-unknown-boards = unknown boards
zconnect-retained = Unsupported or unmapped mail retained for manual review; processing incomplete
zconnect-acknowledged = Manual acknowledgement completed; only use after verified external delivery
zconnect-uploaded = uploaded
zconnect-downloaded = downloaded archives
zconnect-exchange-failed = ZCONNECT scan or exchange failed; checking already received archives anyway
zconnect-toss-failed = ZCONNECT inbound processing incomplete
config = path/file name of the icyboard.toml configuration file
hub = hub ID, every hub when left out
address = the address to call, every link when left out
keep = leave delivered files in the outbound instead of deleting them
poll-verbose = report what the session is doing
file = the packet or bundle to look into
text = print the message text as well
toss-verbose = report what the tosser is doing
scan-verbose = report what the scanner is doing