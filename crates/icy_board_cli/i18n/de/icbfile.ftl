about = icy_board-Dateibereiche konvertieren und verwalten
version = Version ausgeben und beenden
areas-about = die in einer file_areas.toml definierten Bereiche auflisten
list-about = Dateien eines Bereichs mit ihren Beschreibungen auflisten
scan-about = Beschreibungen aus den Archiven eines Bereichs ermitteln
check-about = Einträge mit fehlender Datei oder abweichender Dateigröße melden
import-about = Beschreibungen aus PCBoard-DIR-Listen oder FILES.BBS-Dateien einlesen
export-about = die Beschreibungen eines Bereichs als FILES.BBS ausgeben
set-about = Beschreibung oder Kennzeichen einer einzelnen Datei ändern
repack-about = Archive eines Bereichs ohne enthaltene Intros als zip-Dateien neu schreiben
fingerprints-about = Dateien eines Verzeichnisses erfassen, damit repack sie wiedererkennt
areas = Pfad zur Bereichsliste
target = ein Dateiverzeichnis oder eine file_areas.toml zusammen mit --area
scan-target = ein Dateiverzeichnis oder eine file_areas.toml zusammen mit --area oder --all
area = Bereichsname oder Index, wenn das Ziel eine file_areas.toml ist
long = auch Größe, Datum und Download-Anzahl anzeigen
all = jeden Bereich einer file_areas.toml durchsuchen
force = importierte oder von Hand bearbeitete Beschreibungen neu ermitteln
prune = Einträge entfernen, deren Datei fehlt
listings = die einzulesenden Dateilisten
format = Listenformat: auto, pcboard oder filesbbs
dry-run = geplante Änderungen melden, ohne etwas zu schreiben
overwrite = vorhandene Beschreibungen ersetzen
keep-missing = auch Einträge importieren, deren Datei nicht im Verzeichnis liegt
output = in diese Datei statt auf stdout schreiben, als cp437 kodiert
file = die zu ändernde Datei
desc = die neue Beschreibung
free = Download kostet keine Zeit: true oder false
locked = Datei kann nicht heruntergeladen werden: true oder false
fingerprints = Fingerabdrücke der zu entfernenden Intros, erzeugt mit dem Befehl fingerprints
keep-case = Groß-/Kleinschreibung der Dateinamen beibehalten
compression-level = zip-Deflate-Kompressionsstufe von 0 bis 9
max-members = maximal zulässige Anzahl von Einträgen pro Archiv
max-member-size = maximale entpackte Größe eines Eintrags in Bytes
max-expanded-size = maximale entpackte Größe des gesamten Archivs in Bytes
max-compression-ratio = maximal zulässiges Verhältnis von entpackter zu komprimierter Größe
input = das Verzeichnis mit den Intros
fingerprints-output = Ausgabepfad für die Fingerabdrücke
unknown-format = unbekanntes Format
expected-format = erwartet wird auto, pcboard oder filesbbs