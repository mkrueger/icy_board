about = FTN- und QWKnet-Nachrichten mit konfigurierten Systemen austauschen
version = Version ausgeben und beenden
links-about = konfigurierte Verbindungen und wartende Dateien auflisten
poll-about = eine Verbindung anrufen und wartende Dateien in beide Richtungen übertragen
scan-about = lokal verfasste Nachrichten für die Verbindungen des jeweiligen Bereichs bündeln
show-about = den Inhalt eines Pakets oder Nachrichtenbündels auflisten
toss-about = eingegangene Nachrichten in die Nachrichtenbereiche einlesen
qwk-links-about = konfigurierte QWKnet-Hubs auflisten
qwk-poll-about = Nachrichten für einen QWKnet-Hub sammeln, austauschen und importieren
qwk-scan-about = REP-Pakete aus lokal verfassten Nachrichten erstellen
qwk-toss-about = wartende QWK-Pakete aus dem Eingangsverzeichnis importieren
config = Pfad/Dateiname der Konfigurationsdatei icyboard.toml
hub = Hub-ID; ohne Angabe werden alle Hubs verarbeitet
address = die anzurufende Adresse; ohne Angabe werden alle Verbindungen angerufen
keep = übertragene Dateien im Ausgangsverzeichnis belassen statt löschen
poll-verbose = den Sitzungsablauf protokollieren
file = das zu untersuchende Paket oder Bündel
text = auch den Nachrichtentext ausgeben
toss-verbose = den Importvorgang protokollieren
scan-verbose = das Sammeln ausgehender Nachrichten protokollieren